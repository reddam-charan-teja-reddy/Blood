MONGODB_URI=mongodb://localhost:27017/blood-network
JWT_SECRET=supersecretjwtsecretkeythatisatleast32charslong
JWT_REFRESH_SECRET=supersecretjwtrefreshsecretkeythatisatleast32charslong
PORT=5000
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Twilio Configuration (Optional - falling back to mock logs if blank)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
BYPASS_OTP=false

# Redis Distributed Cache & Locking (Falls back to in-memory store if blank or offline)
REDIS_URL=redis://127.0.0.1:6379

# Observability & Structured Logging
LOG_LEVEL=info                  # debug | info | warn | error
LOG_FORMAT=pretty               # pretty (colorized console) | json (production log aggregator)
ENABLE_HTTP_LOGGING=true        # true | false

